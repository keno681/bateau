{
  "name": "derniere-vague",
  "version": "1.4.0",
  "private": true,
  "description": "Un jeu de survie en mer : trois marins, un bateau, une tempête.",
  "author": "Dernière Vague",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win portable dir --x64",
    "check": "node --check game.js && node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/patch-store.cjs && node --check desktop/workshop.js && node --check desktop/room.cjs && node --check desktop/lobby.js && node --check desktop/udp-stream.cjs",
    "install:electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.dernierevague.game",
    "productName": "Dernière Vague",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "desktop/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Derniere-Vague-${version}-Windows-x64.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "DerniereVague-1.4.0"
    }
  }
}
